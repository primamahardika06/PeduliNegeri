PORT=5000
CLIENT_URL=http://localhost:5173

# Konfigurasi Supabase
SUPABASE_URL=https://your-project.supabase.co
# Kunci API Baru (Direkomendasikan sesuai @supabase/server skill)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxx
SUPABASE_SECRET_KEY=sb_secret_xxxx

# Kunci API Warisan / Legacy (Opsional jika masih memakai kunci lama di project Supabase Anda)
# SUPABASE_ANON_KEY=xxxx
# SUPABASE_SERVICE_ROLE_KEY=xxxx
